[Unit]
Description=Sotto relay (onion service only)
After=network.target tor.service
Wants=tor.service

[Service]
User=sotto-relay
ExecStart=/usr/local/bin/sotto-relay --listen 127.0.0.1:7400 --data-dir /var/lib/sotto-relay --max-mb 1024
Restart=on-failure
# No logs about requests exist; keep the journal free of anything else too.
StandardOutput=null
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sotto-relay
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
