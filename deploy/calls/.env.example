# Copy to .env (setup.sh does this and fills in random keys). Keep .env out of version control.
CALLS_DOMAIN=calls.example.org
ACME_EMAIL=ops@example.org
LIVEKIT_API_KEY=APIchangeme
LIVEKIT_API_SECRET=at-least-32-random-characters-change-me
# Rooms per minute: for everyone together, and per client address (Tor exits are shared, so keep it generous).
BROKER_RATE_GLOBAL_PER_MIN=120
BROKER_RATE_IP_PER_MIN=20
