# Sotto call broker, built from the source embedded below (base64, so every Docker
# builder accepts it and Compose finds nothing to substitute). Generated by
# deploy/calls/coolify/make.py from crates/sotto-call-broker; don't edit by hand.
FROM rust:1.99.1-slim-trixie AS build
WORKDIR /src
RUN mkdir -p /src/src
# Cargo.toml (463 bytes, sha256 53c3a14f24e95a769b95386f504cf1095e628cdba04e169e426d5702f721818f)
RUN echo '' | base64 -d > /src/Cargo.toml
# src/lib.rs (24112 bytes, sha256 da63e681ec84e23e6230482946f2a0ef7f462f7478a9779490ffb217c5fadefb)
RUN echo '' | base64 -d > /src/src/lib.rs
# src/main.rs (2497 bytes, sha256 dd56b109701848e8f1d9d6b588a209b255a02aa235c24a14f33e3d84c4ce5802)
RUN echo '' | base64 -d > /src/src/main.rs
# Cargo.lock (28057 bytes, sha256 9daf9604df632c3d432d6c74eec22cc5e023e369271971a6fa66ffc287b5e587)
RUN echo '' | base64 -d > /src/Cargo.lock
RUN cargo build --release --locked

# Distroless: no shell, runs as a non-root user.
FROM gcr.io/distroless/cc-debian13:nonroot
COPY --from=build /src/target/release/sotto-call-broker /usr/local/bin/sotto-call-broker
USER nonroot
EXPOSE 7890
ENTRYPOINT ["/usr/local/bin/sotto-call-broker"]
